include README.md LICENSE CHANGELOG.md CONTRIBUTING.md CITATION.cff AUTHORS.md SECURITY.md
include .editorconfig .gitattributes environment.yml
recursive-include .devcontainer *.json
recursive-include .vscode *.json
recursive-include docs *.md
recursive-include examples *.py
recursive-include notebooks *.ipynb *.md
recursive-include requirements *.txt
recursive-include scripts *.py
recursive-include src *.py
recursive-include tests *.py
prune artifacts
prune data
prune manuscript
prune reports
prune work
global-exclude *.py[cod] __pycache__ .pytest_cache .ruff_cache
